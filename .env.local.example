GARMIN_EMAIL=tu.correo@ejemplo.com
GARMIN_PASSWORD=tu-contraseña-de-garmin-connect

# Base de datos Redis gratuita (Upstash) donde se guarda la sesión de Garmin
# y el caché de actividades. Créala en https://console.upstash.com — copia
# los valores "REST URL" y "REST Token" de tu base de datos.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Contraseña compartida para que solo tú, tu familia y tus amigos puedan
# entrar a la app cuando esté desplegada en un link público. Déjala vacía
# para desarrollo local si no quieres pedir contraseña en tu propia máquina.
APP_PASSWORD=
